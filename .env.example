# =====================================================
# PresentIQ — environment variables
# =====================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- AI Provider ---
# anthropic is the default. If unset, the platform falls back to a deterministic
# mock provider so you can run the full pipeline without an API key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe ---
# If unset, billing endpoints will return 503 (stripe_not_configured).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Stripe price IDs (per plan, monthly + annual) ---
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
STRIPE_PRICE_BUSINESS_ANNUAL=price_...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) ---
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_...
