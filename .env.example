# ---- Beyond Style UAE — environment variables ----
# Copy to .env.local and fill in. NEVER commit real keys.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes / server actions for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider wrapper (pick ONE) ----
# Options: groq | together | openai | openai_compatible | anthropic | gemini | mock
# "mock" needs no key and returns placeholder analysis (good for first run).
# Recommended open-model setup: groq (Llama 3.1 70B) or together (Qwen 2.5 72B).
AI_PROVIDER=mock

# Groq — open models, OpenAI-compatible (Llama 3.1 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Together AI — open models, OpenAI-compatible (Qwen 2.5 72B)
TOGETHER_API_KEY=
TOGETHER_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo

# Any other OpenAI-compatible endpoint
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ---- NotebookLM (Google) OAuth integration ----
# Create an OAuth 2.0 "Web application" client in Google Cloud Console
# (APIs & Services → Credentials). Add the redirect URI below as an
# "Authorized redirect URI" on that client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional. If unset, the app derives it from the request origin as
# <origin>/api/integrations/notebooklm/callback. Set explicitly in production.
GOOGLE_OAUTH_REDIRECT_URI=
# Optional. Space-separated scopes; defaults to openid/email/profile + Drive read-only.
NOTEBOOKLM_OAUTH_SCOPES=

# Optional. Secret used to encrypt stored OAuth tokens (AES-256-GCM).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset. Set a dedicated random
# value in production: `openssl rand -base64 32`.
INTEGRATION_TOKEN_SECRET=
