# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The codebase currently reads BOTH names (Supabase renamed anon -> publishable).
# Set both to the same value until the code is standardised on one, otherwise the
# paths that read the other name fall back to demo/null mode.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider (anthropic | openai)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs
STRIPE_STUDENT_MONTHLY_PRICE_ID=price_...
STRIPE_STUDENT_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# App URL
NEXT_PUBLIC_APP_URL=https://www.tweenz.ae

# Email (optional — for digest notifications)
EMAIL_FROM=noreply@tweenz.ae
RESEND_API_KEY=re_...
