# Supabase (free tier)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the new publishable key (or the legacy anon key — both work)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Optional service-role key (server-only secrets, never ship to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama (local or free VPS)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_REASONING=llama3
OLLAMA_MODEL_FAST=mistral
OLLAMA_MODEL_REWRITE=phi3

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXTENSION_API_KEY=dev-extension-key
