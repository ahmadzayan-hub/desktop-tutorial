{
  "name": "saas-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/tweenz",
    "apps/prompt-optimizer"
  ],
  "scripts": {
    "dev:tweenz": "npm run dev --workspace=apps/tweenz",
    "dev:po": "npm run dev --workspace=apps/prompt-optimizer",
    "build:tweenz": "npm run build --workspace=apps/tweenz",
    "build:po": "npm run build --workspace=apps/prompt-optimizer",
    "build": "npm run build:tweenz && npm run build:po",
    "typecheck:tweenz": "npm run typecheck --workspace=apps/tweenz",
    "typecheck:po": "npm run typecheck --workspace=apps/prompt-optimizer",
    "typecheck": "npm run typecheck:tweenz && npm run typecheck:po"
  }
}
