# WhatsApp Business Cloud API — انسخ لـ .env (أو حطّهم في Environment Variables على Vercel)
# كل دي من لوحة Meta for Developers → تطبيقك → WhatsApp.

# توكن الوصول (Permanent System User token يُفضّل، مش المؤقت).
WHATSAPP_TOKEN=

# معرّف رقم الواتساب المخصّص للـ API (Phone number ID) — مش رقم موبايلك الشخصي.
PHONE_NUMBER_ID=

# توكن تحقّق الـ webhook (انت بتخترعه، وبتحطّه نفسه في إعداد الـ webhook على Meta).
VERIFY_TOKEN=

# مفتاح تطبيق مشترك: تطبيق وصال بيبعته في هيدر x-api-key عشان يستخدم /api/send.
APP_API_KEY=

# سر التطبيق من Meta (App Secret) — لتحقق توقيع الـ webhook (X-Hub-Signature-256).
# اظبطه قبل الاعتماد على الأحداث الواردة؛ من غيره التوقيع مش بيتحقق (بتحذير في اللوج).
APP_SECRET=

# نسخة Graph API (اختياري).
GRAPH_VERSION=v21.0
