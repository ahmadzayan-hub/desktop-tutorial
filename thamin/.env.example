# ── Database ──────────────────────────────────────────────────────────────
# Default: local SQLite (zero-setup, works immediately after `npm run setup`).
# Production: switch prisma/schema.prisma datasource provider to "postgresql"
# and point DATABASE_URL at Supabase/Postgres, e.g.:
#   DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-hex-string"

# ── AI layer (open-source LLMs via any OpenAI-compatible endpoint) ────────
# Works with: Ollama (http://localhost:11434/v1), vLLM, LM Studio,
# Together.ai, Groq, Fireworks — anything speaking the OpenAI chat API.
# Leave AI_BASE_URL empty to run the app without AI (formula engine still works).
AI_BASE_URL=""
AI_API_KEY=""
# Text/reasoning model (tool-calling capable). Recommended open-source:
#   llama-3.1-70b / llama-3.3-70b / qwen2.5-72b-instruct (hosted)
#   llama3.1:8b / qwen2.5:14b (local Ollama)
AI_TEXT_MODEL="llama3.1:8b"
# Vision model for product photo analysis. Recommended open-source:
#   qwen2.5-vl-72b (hosted) / qwen2.5vl:7b or llama3.2-vision:11b (local Ollama)
AI_VISION_MODEL="qwen2.5vl:7b"

# ── Future integrations (placeholders, not required) ──────────────────────
METAL_PRICE_API_KEY=""
EXCHANGE_RATE_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""
ZIINA_API_KEY=""

# Public site URL (used for SEO metadata, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL="https://thamin.vercel.app"
