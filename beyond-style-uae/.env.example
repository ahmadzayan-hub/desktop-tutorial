# ---- Beyond Style UAE — environment variables ----
# Copy to .env.local and fill in. NEVER commit real keys.

# Supabase (project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by API routes / server actions for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider wrapper (pick ONE) ----
# Options: openai | anthropic | gemini | mock
# "mock" needs no key and returns placeholder analysis (good for first run).
AI_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
