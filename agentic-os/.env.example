# Agentic OS environment variables — NAMES ONLY, never real values.
# Copy to .env (gitignored) and fill locally, or use an approved secret manager.

# LLM providers (only set the ones actually in use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional overrides
AGENTIC_OS_ROOT=
AGENTIC_OS_ENVIRONMENT=sandbox
