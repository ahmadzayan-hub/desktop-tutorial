{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/risk.schema.json",
  "title": "Risk",
  "description": "Risk register entry (spec section 30).",
  "type": "object",
  "required": ["risk_id", "description", "domain", "cause", "consequence", "likelihood", "impact", "controls", "owner", "residual_risk", "review_date", "status"],
  "properties": {
    "risk_id": {"type": "string"},
    "description": {"type": "string"},
    "domain": {"type": "string", "enum": ["system", "rta", "bcgt", "mba", "brand", "personal"]},
    "cause": {"type": "string"},
    "consequence": {"type": "string"},
    "likelihood": {"type": "string", "enum": ["high", "medium", "low"]},
    "impact": {"type": "string", "enum": ["high", "medium", "low"]},
    "detectability": {"type": "string"},
    "controls": {"type": "string"},
    "owner": {"type": "string"},
    "residual_risk": {"type": "string"},
    "review_date": {"type": "string"},
    "status": {"type": "string", "enum": ["open", "mitigated", "accepted", "closed"]}
  }
}
