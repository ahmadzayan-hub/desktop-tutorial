{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/transfer.schema.json",
  "title": "CrossDomainTransfer",
  "description": "Controlled exchange record (spec section 6).",
  "type": "object",
  "required": ["transfer_id", "source_domain", "destination_domain", "source_artifact", "requested_information", "business_need", "sanitization_performed", "confidentiality_review", "approval_status"],
  "properties": {
    "transfer_id": {"type": "string"},
    "source_domain": {"type": "string", "enum": ["system", "rta", "bcgt", "mba", "brand", "personal"]},
    "destination_domain": {"type": "string", "enum": ["system", "rta", "bcgt", "mba", "brand", "personal"]},
    "source_artifact": {"type": "string"},
    "requested_information": {"type": "string"},
    "business_need": {"type": "string"},
    "sanitization_performed": {"type": "string"},
    "confidentiality_review": {"type": "string"},
    "approval_status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "approved_by": {"type": "string"},
    "approval_date": {"type": "string"},
    "destination_artifact": {"type": "string"}
  }
}
