{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/verification.schema.json",
  "title": "VerificationResult",
  "description": "Verifier outcome with independence record (spec sections 15-16).",
  "type": "object",
  "required": ["task_id", "level", "result", "checks_performed", "deterministic_checks"],
  "properties": {
    "task_id": {"type": "string"},
    "level": {"type": "string", "enum": ["none", "basic", "standard", "enhanced", "human-mandatory"]},
    "result": {"type": "string", "enum": ["PASS", "PASS-WITH-LIMITATIONS", "FAIL", "NOT-INDEPENDENTLY-VERIFIABLE"]},
    "checks_performed": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "same_model": {"type": "boolean"},
    "separate_context": {"type": "boolean"},
    "independent_sources": {"type": "boolean"},
    "deterministic_checks": {"type": "boolean"},
    "human_review_required": {"type": "boolean"},
    "verified_at": {"type": "string"}
  }
}
