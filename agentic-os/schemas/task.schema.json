{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/task.schema.json",
  "title": "Task",
  "description": "Governed unit of work (spec section 11). Documented in agents/_registry.md.",
  "type": "object",
  "required": ["task_id", "title", "domain", "classification", "requested_by", "created", "priority", "risk", "status", "assigned_role", "autonomy_level", "approval_status", "verification_level"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^TASK-\\d{8}-\\d{3}$"},
    "title": {"type": "string"},
    "domain": {"type": "string", "enum": ["system", "rta", "bcgt", "mba", "brand", "personal"]},
    "classification": {"type": "string", "enum": ["public", "internal", "restricted", "confidential"]},
    "requested_by": {"type": "string"},
    "created": {"type": "string"},
    "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "risk": {"type": "string", "enum": ["high", "medium", "low"]},
    "status": {"type": "string", "enum": ["backlog", "ready", "in-progress", "blocked", "verification", "done", "cancelled"]},
    "assigned_role": {"type": "string", "enum": ["orchestrator", "heavy", "standard", "light", "verifier"]},
    "skill": {"type": "string"},
    "autonomy_level": {"type": "string", "enum": ["observe", "draft", "execute-reversible", "execute-controlled", "prohibited"]},
    "approval_status": {"type": "string", "enum": ["not-required", "pending", "approved", "rejected"]},
    "verification_level": {"type": "string", "enum": ["none", "basic", "standard", "enhanced", "human-mandatory"]},
    "max_agent_turns": {"type": "integer"},
    "max_tool_calls": {"type": "integer"},
    "max_retries": {"type": "integer"},
    "max_heavy_calls": {"type": "integer"},
    "max_runtime_seconds": {"type": "integer"}
  }
}
