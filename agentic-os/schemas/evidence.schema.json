{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/evidence.schema.json",
  "title": "EvidenceBundle",
  "description": "Evidence contract for fact-bearing deliverables (spec section 14).",
  "type": "object",
  "required": ["verification_scope", "source_manifest", "calculations", "assumptions", "inferences", "unverified_items", "verification_date"],
  "properties": {
    "verification_scope": {"type": "string"},
    "verification_date": {"type": "string"},
    "calculations": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "inferences": {"type": "array", "items": {"type": "string"}},
    "unverified_items": {"type": "array", "items": {"type": "string"}},
    "source_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_type", "title_or_file", "location", "retrieved_or_accessed", "supports_claims", "freshness", "authority_level"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"type": "string"},
          "title_or_file": {"type": "string"},
          "location": {"type": "string"},
          "retrieved_or_accessed": {"type": "string"},
          "supports_claims": {"type": "string"},
          "freshness": {"type": "string"},
          "authority_level": {"type": "string", "enum": ["primary", "official-secondary", "internal", "informal"]},
          "limitations": {"type": "string"}
        }
      }
    }
  }
}
