{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/tool.schema.json",
  "title": "ToolRecord",
  "description": "Tool governance record (spec section 20); deny by default.",
  "type": "object",
  "required": ["tool_id", "purpose", "provider", "owner_roles", "allowed_domains", "allowed_actions", "external_side_effect", "approval_required", "health_status"],
  "properties": {
    "tool_id": {"type": "string"},
    "purpose": {"type": "string"},
    "provider": {"type": "string"},
    "owner_roles": {"type": "array", "items": {"type": "string"}},
    "allowed_domains": {"type": "array", "items": {"type": "string"}},
    "allowed_actions": {"type": "array", "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "authentication_method": {"type": "string"},
    "secret_location": {"type": "string"},
    "read_scope": {"type": "string"},
    "write_scope": {"type": "string"},
    "external_side_effect": {"type": "boolean"},
    "approval_required": {"type": "boolean"},
    "rate_limits": {"type": "string"},
    "cost_model": {"type": "string"},
    "last_tested": {"type": "string"},
    "last_used": {"type": "string"},
    "health_status": {"type": "string", "enum": ["healthy", "degraded", "authentication-failed", "unavailable", "untested"]},
    "fallback": {"type": "string"}
  }
}
