{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/artifact-manifest.schema.json",
  "title": "ArtifactManifest",
  "description": "Produced artifact with integrity hash and classification.",
  "type": "object",
  "required": ["artifact_id", "task_id", "path", "domain", "classification", "sha256", "created"],
  "properties": {
    "artifact_id": {"type": "string"},
    "task_id": {"type": "string"},
    "path": {"type": "string"},
    "domain": {"type": "string", "enum": ["system", "rta", "bcgt", "mba", "brand", "personal"]},
    "classification": {"type": "string", "enum": ["public", "internal", "restricted", "confidential"]},
    "sha256": {"type": "string"},
    "created": {"type": "string"},
    "description": {"type": "string"}
  }
}
