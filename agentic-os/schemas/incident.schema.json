{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-os/schemas/incident.schema.json",
  "title": "Incident",
  "description": "Incident record (spec section 31).",
  "type": "object",
  "required": ["incident_id", "date", "domain", "severity", "description", "detected_by", "status"],
  "properties": {
    "incident_id": {"type": "string"},
    "date": {"type": "string"},
    "task_id": {"type": "string"},
    "domain": {"type": "string", "enum": ["system", "rta", "bcgt", "mba", "brand", "personal"]},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
    "description": {"type": "string"},
    "detected_by": {"type": "string"},
    "affected_artifacts": {"type": "string"},
    "affected_tools": {"type": "string"},
    "containment": {"type": "string"},
    "root_cause": {"type": "string"},
    "corrective_action": {"type": "string"},
    "preventive_action": {"type": "string"},
    "owner": {"type": "string"},
    "status": {"type": "string", "enum": ["open", "contained", "resolved", "closed"]}
  }
}
